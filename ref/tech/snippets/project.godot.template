; SKYRUSH project.godot baseline - every key below was read back on Godot 4.7.2 (2026-10-19)
; by ref/tech/probe and ~/m scratch tests. Copy into the game repo as project.godot, then set
; run/main_scene. Values marked "tune" are starting points, not measurements.
config_version=5

[application]
config/name="SKYRUSH: NEON SHANGHAI"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[audio]
general/3d_panning_strength=0.5

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
occlusion_culling/use_occlusion_culling=true
textures/vram_compression/import_s3tc_bptc=true
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.02, 0.024, 0.04, 1)
