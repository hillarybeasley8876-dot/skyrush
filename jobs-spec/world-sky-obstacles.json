{
  "id": "world-sky-obstacles",
  "title": "Obstacles in the sky lanes: drones, billboards, crane arms",
  "brief": "briefs/improve/world-sky-obstacles.md",
  "isolation": "worktree",
  "owns": [
    "game/world/build/sky_lane_builder.gd",
    "game/world/build/sky_obstacles.gd",
    "game/world/tests/test_sky_obstacles.gd"
  ],
  "maxRounds": 4,
  "maxTurns": 250,
  "timeoutMin": 150,
  "accept": [
    {
      "name": "world scripts and scenes load clean",
      "cmd": "python tools/gd.py check --only=res://world/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1800
    },
    {
      "name": "the sky obstacle test passes",
      "cmd": "python tools/gd.py test res://world/tests/test_sky_obstacles.gd",
      "must": [
        "SKY OBSTACLE TESTS OK"
      ],
      "timeoutS": 1200
    },
    {
      "name": "the test fails on the old code",
      "cmd": "python tools/mutation_check.py --test res://world/tests/test_sky_obstacles.gd --files auto",
      "must": [
        "MUTATION_CHECK OK"
      ],
      "timeoutS": 1800
    },
    {
      "name": "the world test folder does not get worse",
      "cmd": "python tools/run_tests.py --filter res://world/ --jobs 3 --out F:/dev/skyrush-out/tmp/world-sky-obstacles/tests --allow-fail test_route_layers,test_world_api",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 3600
    }
  ],
  "readonly": [
    "game/world/tests/probe_path_blockers.gd",
    "game/world/tests/test_drive_lanes.gd",
    "game/world/tests/test_gameplay_sites.gd",
    "game/world/tests/test_lane_surfaces_world.gd",
    "game/world/tests/test_multimesh_inventory.gd",
    "game/world/tests/test_prop_diagnose.gd",
    "game/world/tests/test_prop_shapes.gd",
    "game/world/tests/test_route_layers.gd",
    "game/world/tests/test_site_positions.gd",
    "game/world/tests/test_tile_load.gd",
    "game/world/tests/test_world_api.gd",
    "game/world/tests/test_world_quality.gd",
    "game/world/tests/water_probe.gd",
    "game/world/tests/world_error_counter.gd"
  ]
}
