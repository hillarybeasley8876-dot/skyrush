{
  "id": "rivals-start",
  "title": "The rivals leave the start grid by themselves (no rescue of the back rows)",
  "brief": "briefs/improve/rivals-start.md",
  "isolation": "worktree",
  "owns": [
    "game/ai/rivals/"
  ],
  "maxRounds": 4,
  "maxTurns": 300,
  "timeoutMin": 180,
  "accept": [
    {
      "name": "rivals scripts and scenes load clean",
      "cmd": "python tools/gd.py check --only=res://ai/rivals/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "the rivals drive away from the grid",
      "cmd": "python tools/gd.py test res://ai/rivals/tests/test_rival_driving.gd",
      "must": [
        "RIVAL DRIVING TESTS OK"
      ],
      "timeoutS": 900
    },
    {
      "name": "the race runs through",
      "cmd": "python tools/gd.py test res://ai/rivals/tests/test_race_flow.gd",
      "must": [
        "RACE FLOW TESTS OK"
      ],
      "timeoutS": 900
    },
    {
      "name": "the rivals test folder does not get worse",
      "cmd": "python tools/run_tests.py --filter res://ai/rivals/ --jobs 2 --out F:/dev/skyrush-out/tmp/rivals-start/tests --allow-fail test_performance,test_real_route",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 3000
    }
  ],
  "readonly": [
    "game/ai/rivals/tests/test_layers.gd",
    "game/ai/rivals/tests/test_performance.gd",
    "game/ai/rivals/tests/test_race_flow.gd",
    "game/ai/rivals/tests/test_real_route.gd",
    "game/ai/rivals/tests/test_rival_driving.gd",
    "game/ai/rivals/tests/test_rubber_band.gd"
  ]
}
