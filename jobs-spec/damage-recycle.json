{
  "id": "damage-recycle",
  "title": "A wrecked traffic or police car that comes out of its pool is a whole car again",
  "brief": "briefs/improve/damage-recycle.md",
  "isolation": "worktree",
  "owns": [
    "game/damage/",
    "game/ai/traffic/",
    "game/ai/police/"
  ],
  "maxRounds": 4,
  "maxTurns": 300,
  "timeoutMin": 180,
  "accept": [
    {
      "name": "damage scripts load clean",
      "cmd": "python tools/gd.py check --only=res://damage/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "traffic scripts load clean",
      "cmd": "python tools/gd.py check --only=res://ai/traffic/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "police scripts load clean",
      "cmd": "python tools/gd.py check --only=res://ai/police/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "the recycle test passes",
      "cmd": "python tools/gd.py test res://damage/tests/test_recycle.gd",
      "must": [
        "RECYCLE TESTS OK"
      ],
      "timeoutS": 900
    },
    {
      "name": "the test fails on the old code",
      "cmd": "python tools/mutation_check.py --test res://damage/tests/test_recycle.gd --files auto",
      "must": [
        "MUTATION_CHECK OK"
      ],
      "timeoutS": 1500
    },
    {
      "name": "the damage tests do not get worse",
      "cmd": "python tools/run_tests.py --filter res://damage/ --jobs 3 --out F:/dev/skyrush-out/tmp/damage-recycle/tests_damage --allow-fail test_budget",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 3000
    },
    {
      "name": "the traffic tests do not get worse",
      "cmd": "python tools/run_tests.py --filter res://ai/traffic/ --jobs 3 --out F:/dev/skyrush-out/tmp/damage-recycle/tests_traffic --allow-fail test_lanes_world",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 3000
    },
    {
      "name": "the police tests do not get worse",
      "cmd": "python tools/run_tests.py --filter res://ai/police/ --jobs 3 --out F:/dev/skyrush-out/tmp/damage-recycle/tests_police --allow-fail test_perf",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 3000
    }
  ],
  "readonly": [
    "game/damage/tests/damage_test_kit.gd",
    "game/damage/tests/test_budget.gd",
    "game/damage/tests/test_collision_severity.gd",
