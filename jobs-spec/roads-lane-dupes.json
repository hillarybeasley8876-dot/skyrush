{
  "id": "roads-lane-dupes",
  "title": "No two connectors for the same movement (two junctions close together each built it)",
  "brief": "briefs/improve/roads-lane-dupes.md",
  "isolation": "worktree",
  "sparse": [
    "tools/",
    "data/",
    "ref/",
    "briefs/",
    "blender/",
    "game/assets/textures/",
    "game/assets/city/_tex/",
    "game/world/data/",
    "SPEC.md",
    "ART.md",
    "CONTRACTS.md",
    "README.md"
  ],
  "owns": [
    "blender/city/roads/lane_links.py"
  ],
  "maxRounds": 4,
  "maxTurns": 250,
  "timeoutMin": 180,
  "accept": [
    {
      "name": "full Blender road build into the scratch directory",
      "timeoutS": 1500,
      "cmd": "python tools/gd.py blender run blender/city/roads/build_roads.py -- --out F:/dev/skyrush-out/tmp/roads-lane-dupes/tiles --data F:/dev/skyrush-out/tmp/roads-lane-dupes/full",
      "must": [
        "DONE in"
      ]
    },
    {
      "name": "one connector per movement, no movement lost or added",
      "cmd": "python tools/city/check_lane_dupes.py F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json --ref F:/dev/skyrush-out/tmp/roads-lane-dupes/ref_lanes.json --quiet",
      "must": [
        "LANE_DUPES OK"
      ]
    },
    {
      "name": "the lane graph is intact",
      "cmd": "python tools/city/check_lane_graph.py F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json --quiet && python tools/city/check_chain_links.py F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json --quiet",
      "must": [
        "LANE_GRAPH OK",
        "CHAIN_LINKS OK"
      ]
    },
    {
      "name": "every race route is drivable",
      "timeoutS": 900,
      "cmd": "python tools/city/check_routes_drivable.py data/city/city.json F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json",
      "must": [
        "ROUTES_DRIVABLE OK"
      ]
    },
    {
      "name": "the road surface does not lose coverage",
      "timeoutS": 900,
      "cmd": "python tools/city/check_surface_coverage.py F:/dev/skyrush-out/tmp/roads-lane-dupes/tiles F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json --max-bad 4175",
      "must": [
        "SURFACE_COVERAGE bad samples"
      ]
    },
    {
      "name": "no lane of the city is walled off",
      "timeoutS": 900,
      "cmd": "python tools/city/check_path_blockers.py F:/dev/skyrush-out/tmp/roads-lane-dupes/tiles --lanes F:/dev/skyrush-out/tmp/roads-lane-dupes/full/lanes.json --max-bad 25 --max-barrier-area 395000",
      "must": [
        "PATH_BLOCKERS OK"
      ]
    }
  ]
}