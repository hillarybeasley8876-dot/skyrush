{
  "id": "roads-joint-ends",
  "title": "Fence the deck ends where a wide elevated road meets a narrow one, so cars do not drive off",
  "brief": "briefs/improve/roads-joint-ends.md",
  "isolation": "worktree",
  "sparse": [
    "tools/",
    "data/",
    "ref/",
    "briefs/",
    "blender/",
    "game/assets/textures/",
    "game/assets/city/_tex/",
    "game/world/data/",
    "SPEC.md",
    "ART.md",
    "CONTRACTS.md",
    "README.md"
  ],
  "owns": [
    "blender/city/roads/deck.py",
    "blender/city/roads/build_roads.py"
  ],
  "maxRounds": 4,
  "maxTurns": 250,
  "timeoutMin": 180,
  "accept": [
    {
      "name": "full Blender road build into the scratch directory",
      "timeoutS": 1500,
      "cmd": "python tools/gd.py blender run blender/city/roads/build_roads.py -- --out F:/dev/skyrush-out/tmp/roads-joint-ends/tiles --data F:/dev/skyrush-out/tmp/roads-joint-ends/data",
      "must": ["DONE in"]
    },
    {
      "name": "no lane end at a deck joint runs off the deck",
      "cmd": "python tools/city/check_joint_runoff.py F:/dev/skyrush-out/tmp/roads-joint-ends/tiles F:/dev/skyrush-out/tmp/roads-joint-ends/data/lanes.json data/city/city.json --quiet",
      "must": ["JOINT_RUNOFF OK"]
    },
    {
      "name": "the chain joints still drive through",
      "cmd": "python tools/city/check_path_blockers.py F:/dev/skyrush-out/tmp/roads-joint-ends/tiles F:/dev/skyrush-out/paths_now/chain --lip 0.25 --max-lips 0 --max-bad 0 --max-barrier-area 395000",
      "must": ["PATH_BLOCKERS OK"]
    },
    {
      "name": "the ramp attaches still drive through",
      "cmd": "python tools/city/check_path_blockers.py F:/dev/skyrush-out/tmp/roads-joint-ends/tiles F:/dev/skyrush-out/paths_now/attach --lip 0.25 --max-lips 10 --max-bad 0 --max-barrier-area 395000",
      "must": ["PATH_BLOCKERS OK"]
    },
    {
      "name": "no lane of the city is walled off",
      "cmd": "python tools/city/check_path_blockers.py F:/dev/skyrush-out/tmp/roads-joint-ends/tiles --lanes F:/dev/skyrush-out/tmp/roads-joint-ends/data/lanes.json --max-bad 32 --max-barrier-area 395000",
      "must": ["PATH_BLOCKERS OK"]
    },
    {
      "name": "the open deck edges do not grow",
      "cmd": "python tools/city/check_open_edges.py F:/dev/skyrush-out/tmp/roads-joint-ends/tiles F:/dev/skyrush-out/tmp/roads-joint-ends/data/lanes.json --max-regular 190 --max-connector 23 --top 0",
      "must": ["OPEN_EDGES OK"]
    },
    {
      "name": "the lane graph is intact",
      "cmd": "python tools/city/check_lane_graph.py F:/dev/skyrush-out/tmp/roads-joint-ends/data/lanes.json --quiet && python tools/city/check_chain_links.py F:/dev/skyrush-out/tmp/roads-joint-ends/data/lanes.json --quiet",
      "must": ["LANE_GRAPH OK", "CHAIN_LINKS OK"]
    }
  ]
}
