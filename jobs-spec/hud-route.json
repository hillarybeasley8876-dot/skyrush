{
  "id": "hud-route",
  "title": "The minimap shows the race route and the next gate",
  "brief": "briefs/improve/hud-route.md",
  "isolation": "worktree",
  "owns": [
    "game/modes/",
    "game/ui/hud/"
  ],
  "maxRounds": 4,
  "maxTurns": 250,
  "timeoutMin": 150,
  "accept": [
    {
      "name": "hud scripts load clean",
      "cmd": "python tools/gd.py check --only=res://ui/hud/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "modes scripts load clean",
      "cmd": "python tools/gd.py check --only=res://modes/",
      "must": [
        "re:CHECK \\d+ files, 0 failed, 0 engine errors"
      ],
      "timeoutS": 1200
    },
    {
      "name": "the route marker test passes",
      "cmd": "python tools/gd.py test res://ui/hud/tests/test_route_marker.gd",
      "must": [
        "ROUTE MARKER TESTS OK"
      ],
      "timeoutS": 900
    },
    {
      "name": "the test fails on the old code",
      "cmd": "python tools/mutation_check.py --test res://ui/hud/tests/test_route_marker.gd --files auto",
      "must": [
        "MUTATION_CHECK OK"
      ],
      "timeoutS": 1500
    },
    {
      "name": "the hud tests do not get worse",
      "cmd": "python tools/run_tests.py --filter res://ui/hud/ --jobs 2 --out F:/dev/skyrush-out/tmp/hud-route/tests_hud --allow-fail test_hud_perf",
      "must": [
        "RUN_TESTS_RATCHET OK"
      ],
      "timeoutS": 2400
    },
    {
      "name": "the modes tests pass",
      "cmd": "python tools/run_tests.py --filter res://modes/ --jobs 2 --out F:/dev/skyrush-out/tmp/hud-route/tests_modes",
      "must": [
        "re:, 0 failed or timed out"
      ],
      "timeoutS": 2400
    }
  ],
  "readonly": [
    "game/modes/tests/test_gate_layers.gd",
    "game/modes/tests/test_hygiene.gd",
    "game/modes/tests/test_mode_switch.gd",
    "game/modes/tests/test_modes.gd",
    "game/modes/tests/test_out_of_bounds.gd",
    "game/modes/tests/test_pursuit_mode.gd",
    "game/modes/tests/test_status.gd",
    "game/ui/hud/tests/test_hud.gd",
    "game/ui/hud/tests/test_hud_layout.gd",
    "game/ui/hud/tests/test_hud_perf.gd",
    "game/ui/hud/tests/test_mode_status.gd"
  ]
}
