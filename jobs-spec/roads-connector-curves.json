{
  "id": "roads-connector-curves",
  "title": "The junction connectors are smooth curves (no loops, no back-ups, no corners)",
  "brief": "briefs/improve/roads-connector-curves.md",
  "isolation": "worktree",
  "sparse": [
    "tools/",
    "data/",
    "ref/",
    "briefs/",
    "blender/",
    "game/assets/textures/",
    "game/assets/city/_tex/",
    "game/world/data/",
    "SPEC.md",
    "ART.md",
    "CONTRACTS.md",
    "README.md"
  ],
  "owns": [
    "blender/city/roads/lane_paths.py",
    "blender/city/roads/connector_curve.py"
  ],
  "maxRounds": 4,
  "maxTurns": 300,
  "timeoutMin": 240,
  "accept": [
    {
      "name": "full Blender road build into the scratch directory",
      "timeoutS": 1500,
      "cmd": "python tools/gd.py blender run blender/city/roads/build_roads.py -- --out F:/dev/skyrush-out/tmp/roads-connector-curves/tiles --data F:/dev/skyrush-out/tmp/roads-connector-curves/full",
      "must": [
        "DONE in"
      ]
    },
    {
      "name": "the connectors are smooth (at most 150 loops or kinks, 1093 today)",
      "cmd": "python tools/city/check_connector_shape.py F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --max 150",
      "must": [
        "CONNECTOR_SHAPE OK"
      ]
    },
    {
      "name": "no lane of the city is walled off",
      "timeoutS": 900,
      "cmd": "python tools/city/check_path_blockers.py F:/dev/skyrush-out/tmp/roads-connector-curves/tiles --lanes F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --max-bad 25 --max-barrier-area 395000",
      "must": [
        "PATH_BLOCKERS OK"
      ]
    },
    {
      "name": "the road surface does not lose coverage",
      "timeoutS": 900,
      "cmd": "python tools/city/check_surface_coverage.py F:/dev/skyrush-out/tmp/roads-connector-curves/tiles F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --max-bad 3895",
      "must": [
        "SURFACE_COVERAGE bad samples"
      ]
    },
    {
      "name": "the lane graph is as before (dead ends, duplicates, chains)",
      "cmd": "python tools/city/check_lane_graph.py F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --max-junction-termini 10 && python tools/city/check_lane_dupes.py F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --quiet && python tools/city/check_chain_links.py F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --quiet",
      "must": [
        "LANE_GRAPH OK",
        "LANE_DUPES OK",
        "CHAIN_LINKS OK"
      ]
    },
    {
      "name": "every race route is drivable",
      "timeoutS": 900,
      "cmd": "python tools/city/check_routes_drivable.py data/city/city.json F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json",
      "must": [
        "ROUTES_DRIVABLE OK"
      ]
    },
    {
      "name": "the two-way roads of a junction can be left there (8 explained cases left, outside the files of the job)",
      "cmd": "python tools/city/check_junction_exits.py data/city/city.json F:/dev/skyrush-out/tmp/roads-connector-curves/full/lanes.json --max 8",
      "must": [
        "JUNCTION_EXITS OK"
      ]
    }
  ]
}
