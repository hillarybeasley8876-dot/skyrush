extends AudioStreamPlayer3D
## Cold-gas thruster voice: broadband hiss split into the rear (R) and perimeter (P) nozzle
## groups, the Big Hop charge tone, and the pneumatic chuff on cut-off.
##
## Sound spec (ref/roadster/DOSSIER.md §6.1): broadband roaring hiss, spectrum flat, centroid
## ~2.5-3.3 kHz, sharp 30 ms attack, 120 ms release, pitch +-5 % with throttle, no combustion
## rumble. The hiss comes from a pre-filtered periodic noise table
## (game/audio/tables/hiss_noise.wav, generated by tools/audio/gen_noise_table.py): a 2-pole
## high-pass 600 Hz, two 2-pole low-pass 5 kHz stages and a +6 dB peak at 3.5 kHz. The table is
## read at the full mix rate, so the band really reaches 8 kHz and there is no resampling image.
## The generator is the single source of those numbers.
##
## This is the second of the two synth voices the project budget allows.

const Tuning := preload("res://audio/audio_tuning.gd")
const ChuffVoiceScript := preload("res://audio/synth/chuff_voice.gd")

## 0..1 — normalised output of the rear nozzles (Nozzle_R1..R4).
@export var thrust_rear: float = 0.0
## 0..1 — normalised output of the perimeter nozzles (Nozzle_P1..P6).
@export var thrust_perimeter: float = 0.0
## 0..1 — Big Hop charge progress; drives the rising charge tone.
@export var hop_charge: float = 0.0

@export var hiss_gain: float = 0.55
## The rear group is this many dB louder than the perimeter group at full thrust.
@export var rear_trim_db: float = Tuning.REAR_GROUP_TRIM_DB
## Overall output trim (dB) — the level the thrusters sit at in the mix.
@export var output_gain_db: float = Tuning.THRUSTER_OUTPUT_GAIN_DB
## Mute the voice (e.g. while the car is not the player's).
@export var active: bool = true
## The pneumatic chuff can be switched off (the test renders the hiss without it).
@export var chuff_enabled: bool = true

## The triangle of the tremolo: 0 -> 1 -> 0 (the scale turns the phase into the triangle).
const TRIANGLE_SCALE := 4.0
## The seconds the envelope is given to open before an offline render.
const WARMUP_S := 0.25
## The length of the generator buffer (s).
const BUFFER_LENGTH_S := 0.1
## How many frames the CPU average covers.
const CPU_AVERAGE_FRAMES := 30
## The microseconds per millisecond.
const USEC_PER_MSEC := 1000.0
const HISS_TABLE_PATH := "res://audio/tables/hiss_noise.wav"

var _pb: AudioStreamGeneratorPlayback
var _rate := 48000.0
## The pre-filtered hiss table (as floats, so the read is a single array access).
var _hiss_data := PackedFloat32Array()
var _hiss_size := 0
var _hiss_pos := 0.0
## The rear body layer (a 2-pole low-pass of the same table).
var _body_s1 := 0.0
var _body_s2 := 0.0
var _body_b0 := 0.0
var _body_b1 := 0.0
var _body_b2 := 0.0
var _body_a1 := 0.0
var _body_a2 := 0.0
# the envelopes (one update per mix sample)
var _env_r := 0.0
var _env_p := 0.0
# the pneumatic chuff
## The pneumatic chuff (the burst of escaping air on cut-off).
var _chuff_voice: ChuffVoiceScript
var _was_hot := false
# the Big Hop charge tone (a detuned saw pair through a resonant low-pass)
var _hop_a := 0.0
var _hop_b := 0.0
var _hop_s1 := 0.0
var _hop_s2 := 0.0
var _hop_b0 := 0.0
var _hop_b1 := 0.0
var _hop_b2 := 0.0
var _hop_a1 := 0.0
var _hop_a2 := 0.0
var _trem_phase := 0.0
## Rolling average of the time this voice spends rendering (ms per frame) — the audio CPU budget.
var cpu_ms := 0.0
## Total time spent rendering and total samples produced, for the per-second-of-audio cost.
var cpu_total_usec := 0.0
var samples_total := 0
var _cpu_accum := 0.0
var _cpu_frames := 0


func _init() -> void:
	# the tables exist before the node is in the tree, so an offline render (the tests) produces
	# the same signal as the live voice
	_load_hiss_table()
	_update_body_coefficients()
	_chuff_voice = ChuffVoiceScript.new()
	_chuff_voice.setup(_rate, _hiss_data)


func _ready() -> void:
	_rate = AudioServer.get_mix_rate()
	_update_body_coefficients()
	_chuff_voice.setup(_rate, _hiss_data)
	var gen := AudioStreamGenerator.new()
	gen.mix_rate = _rate
	gen.buffer_length = BUFFER_LENGTH_S
	stream = gen
	# the voice of the player's own car is not doppler shifted: the engine and the driver
	# move together, and a chase camera that does not track its velocity would pull the
	# motor note down by a fifth at 250 km/h
	doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
	play()
	_pb = get_stream_playback() as AudioStreamGeneratorPlayback


## Loads the pre-filtered hiss table and picks a random start so the hiss never repeats in phase.
func _load_hiss_table() -> void:
	var stream := load(HISS_TABLE_PATH) as AudioStreamWAV
	if stream == null:
		push_error("[audio] the hiss table %s is missing" % HISS_TABLE_PATH)
		return
	var raw := stream.get_data()
	_hiss_size = raw.size() / 2
	_hiss_data.resize(_hiss_size)
	for i in _hiss_size:
		_hiss_data[i] = float(raw.decode_s16(i * 2)) / Tuning.S16_SCALE
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	_hiss_pos = float(rng.randi_range(0, maxi(0, _hiss_size - 1)))


## The RBJ low-pass of the rear body layer (two poles, so no rumble comes through).
func _update_body_coefficients() -> void:
	var w := TAU * Tuning.REAR_BODY_HZ / _rate
	var cw := cos(w)
	var alpha := sin(w) / (2.0 * Tuning.HISS_FILTER_Q)
	var a0 := 1.0 + alpha
	_body_b0 = ((1.0 - cw) / 2.0) / a0
	_body_b1 = (1.0 - cw) / a0
	_body_b2 = ((1.0 - cw) / 2.0) / a0
	_body_a1 = -2.0 * cw / a0
	_body_a2 = (1.0 - alpha) / a0


## The RBJ low-pass of the charge tone (the cutoff opens with the charge).
func _update_hop_filter(cutoff_hz: float) -> void:
	var w := TAU * cutoff_hz / _rate
	var cw := cos(w)
	var alpha := sin(w) / (2.0 * Tuning.HOP_FILTER_Q)
	var a0 := 1.0 + alpha
	_hop_b0 = ((1.0 - cw) / 2.0) / a0
	_hop_b1 = (1.0 - cw) / a0
	_hop_b2 = _hop_b0
	_hop_a1 = -2.0 * cw / a0
	_hop_a2 = (1.0 - alpha) / a0


## The polyBLEP correction of a saw (it removes the aliasing at the discontinuity).
static func _poly_blep(t: float, dt: float) -> float:
	if t < dt:
		var x := t / dt
		return x + x - x * x - 1.0
	if t > 1.0 - dt:
		var x := (t - 1.0) / dt
		return x * x + x + x + 1.0
	return 0.0


func _process(_delta: float) -> void:
	if _pb == null:
		return
	var frames := _pb.get_frames_available()
	if frames <= 0:
		return
	var t0 := Time.get_ticks_usec()
	_pb.push_buffer(render(frames))
	var spent := float(Time.get_ticks_usec() - t0)
	cpu_total_usec += spent
	samples_total += frames
	_cpu_accum += spent
	_cpu_frames += 1
	if _cpu_frames >= CPU_AVERAGE_FRAMES:
		cpu_ms = _cpu_accum / float(_cpu_frames) / USEC_PER_MSEC
		_cpu_accum = 0.0
		_cpu_frames = 0


## Renders `frames` samples of the thruster voice.
func render(frames: int) -> PackedVector2Array:
	# the attack is a sharp jet: the envelope reaches 90 % of its target after THRUSTER_ATTACK_S
	var attack_tau := Tuning.THRUSTER_ATTACK_S / Tuning.THRUSTER_ATTACK_SPAN_TAU
	var at := 1.0 - exp(-1.0 / (attack_tau * _rate))
	var rel := 1.0 - exp(-1.0 / (Tuning.THRUSTER_RELEASE_S * _rate))
	var target_r := clampf(thrust_rear, 0.0, 1.0)
	var target_p := clampf(thrust_perimeter, 0.0, 1.0)
	var hot := target_r + target_p > Tuning.THRUSTER_ACTIVE_EPSILON
	# the pneumatic chuff fires on cut-off, not on ignition
	if _was_hot and not hot and chuff_enabled:
		_chuff_voice.fire()
	_was_hot = hot
	var hop := clampf(hop_charge, 0.0, 1.0)
	var hop_f := Tuning.HOP_TONE_LOW_HZ + (Tuning.HOP_TONE_HIGH_HZ - Tuning.HOP_TONE_LOW_HZ) * hop
	# the low-pass of the charge tone opens with the charge
	var hop_cut := Tuning.HOP_FILTER_LOW_HZ + (Tuning.HOP_FILTER_HIGH_HZ - Tuning.HOP_FILTER_LOW_HZ) * hop
	_update_hop_filter(hop_cut)
	# the two saws of the charge tone (they are detuned against each other)
	var hop_inc_a := hop_f / _rate
	var hop_inc_b := hop_f * Tuning.HOP_DETUNE / _rate
	# the tremolo of the charge tone speeds up towards the full charge
	var trem_hz := Tuning.HOP_TREMOLO_MIN_HZ + (Tuning.HOP_TREMOLO_MAX_HZ - Tuning.HOP_TREMOLO_MIN_HZ) * hop
	var trem_inc := trem_hz / _rate
	var gain := db_to_linear(output_gain_db) * (hiss_gain if active else 0.0)
	# the rear group is louder than the perimeter group
	var g_r := gain * db_to_linear(rear_trim_db)
	var g_p := gain
	var body_trim := db_to_linear(Tuning.REAR_BODY_DB)
	# the hiss pitch follows the thrust by +-5 %
	var swing := 1.0 + Tuning.THRUSTER_PITCH_SWING * (target_r + target_p) * 0.5
	# local copies of the persistent state (locals are much faster than member access)
	var hiss_pos := _hiss_pos
	var body_s1 := _body_s1
	var body_s2 := _body_s2
	var env_r := _env_r
	var env_p := _env_p
	var hop_a := _hop_a
	var hop_b := _hop_b
	var hop_s1 := _hop_s1
	var hop_s2 := _hop_s2
	var trem_phase := _trem_phase
	var buf := PackedVector2Array()
	buf.resize(frames)
	for i in frames:
		env_r += (at if target_r > env_r else rel) * (target_r - env_r)
		env_p += (at if target_p > env_p else rel) * (target_p - env_p)
		var s := 0.0
		# --- the hiss: the pre-filtered table, read at the thrust pitch ---
		# (the table read is inlined, a call per sample is too slow)
		hiss_pos += swing
		if hiss_pos >= float(_hiss_size):
			hiss_pos -= float(_hiss_size)
		var hi := int(hiss_pos)
		var hj := hi + 1
		if hj >= _hiss_size:
			hj = 0
		var hfrac := hiss_pos - float(hi)
		var hiss := _hiss_data[hi] + (_hiss_data[hj] - _hiss_data[hi]) * hfrac
		s += hiss * (env_p * g_p + env_r * g_r)
		# --- the rear body layer (a 2-pole low-pass of the same table) ---
		if env_r > Tuning.THRUSTER_ACTIVE_EPSILON:
			var body_y := _body_b0 * hiss + _body_b1 * body_s1 + _body_b2 * body_s2 \
					- _body_a1 * body_s1 - _body_a2 * body_s2
			body_s2 = body_s1
			body_s1 = body_y
			s += body_y * env_r * g_r * body_trim
		# --- Big Hop charge tone: a detuned saw pair through a resonant low-pass ---
		if hop > Tuning.HOP_ACTIVE_EPSILON:
			hop_a += hop_inc_a
			if hop_a >= 1.0:
				hop_a -= 1.0
			hop_b += hop_inc_b
			if hop_b >= 1.0:
				hop_b -= 1.0
			trem_phase += trem_inc
			if trem_phase >= 1.0:
				trem_phase -= 1.0
			# the two band-limited saws (the polyBLEP correction is inlined: a call per
			# sample would cost more than the rest of the voice)
			var blep_a := 0.0
			if hop_a < hop_inc_a:
				var xa := hop_a / hop_inc_a
				blep_a = xa + xa - xa * xa - 1.0
			elif hop_a > 1.0 - hop_inc_a:
				var xa2 := (hop_a - 1.0) / hop_inc_a
				blep_a = xa2 * xa2 + xa2 + xa2 + 1.0
			var blep_b := 0.0
			if hop_b < hop_inc_b:
				var xb := hop_b / hop_inc_b
				blep_b = xb + xb - xb * xb - 1.0
			elif hop_b > 1.0 - hop_inc_b:
				var xb2 := (hop_b - 1.0) / hop_inc_b
				blep_b = xb2 * xb2 + xb2 + xb2 + 1.0
			var saw := (2.0 * hop_a - 1.0 - blep_a) + (2.0 * hop_b - 1.0 - blep_b)
			# the resonant low-pass
			var y := _hop_b0 * saw + _hop_b1 * hop_s1 + _hop_b2 * hop_s2 \
					- _hop_a1 * hop_s1 - _hop_a2 * hop_s2
			hop_s2 = hop_s1
			hop_s1 = y
			# a triangle from the tremolo phase, no extra table lookup
			var tri := trem_phase * TRIANGLE_SCALE
			if tri > TRIANGLE_SCALE * 0.5:
				tri = TRIANGLE_SCALE - tri
			s += y * hop * Tuning.HOP_TONE_GAIN * (Tuning.HOP_TREMOLO_MIN + tri * Tuning.HOP_TREMOLO_SPAN)
		# --- the pneumatic chuff on cut-off ---
		if _chuff_voice.active():
			s += _chuff_voice.sample()
		buf[i] = Vector2(s, s)
	_hiss_pos = hiss_pos
	_body_s1 = body_s1
	_body_s2 = body_s2
	_env_r = env_r
	_env_p = env_p
	_hop_a = hop_a
	_hop_b = hop_b
	_hop_s1 = hop_s1
	_hop_s2 = hop_s2
	_trem_phase = trem_phase
	return buf


## Clears the filter and envelope state (used before an offline measurement).
func reset() -> void:
	_body_s1 = 0.0
	_body_s2 = 0.0
	_env_r = 0.0
	_env_p = 0.0
	_chuff_voice.reset()
	_hop_a = 0.0
	_hop_b = 0.0
	_hop_s1 = 0.0
	_hop_s2 = 0.0
	_trem_phase = 0.0
	_was_hot = false


## Renders `frames` samples of settled hiss and returns them as a mono buffer (offline use).
func render_offline(frames: int) -> PackedFloat32Array:
	reset()
	render(int(WARMUP_S * _rate))  # let the envelope open
	var buf := render(frames)
	var out := PackedFloat32Array()
	out.resize(buf.size())
	for i in buf.size():
		out[i] = buf[i].x
	return out


## Number of buffer underruns (0 is healthy).
func skips() -> int:
	return -1 if _pb == null else _pb.get_skips()
