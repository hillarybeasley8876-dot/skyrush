; Engine configuration file. Core-owned (SKYRUSH lead). Units must not edit this file:
; put requests in status/<unit>.md. Input actions are registered at runtime by core/input_setup.gd.

config_version=5

[application]

config/name="飞驰申城 SKYRUSH"
config/description="Cyberpunk night-Shanghai arcade racer starring the 2026 Tesla Roadster"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Events="*res://core/events.gd"
Game="*res://core/game.gd"
Settings="*res://core/settings.gd"
Modules="*res://core/modules.gd"

[display]

window/vsync/vsync_mode=1
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicle"
3d_physics/layer_3="prop"
3d_physics/layer_4="trigger"
3d_physics/layer_5="debris"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=4
common/physics_interpolation=false

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=false
occlusion_culling/use_occlusion_culling=true
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=false
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.05, 1)

[shader_globals]

skyrush_wetness={
"type": "float",
"value": 0.85
}
skyrush_rain={
"type": "float",
"value": 0.0
}
